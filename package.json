{
	"name": "@limbo-works/lint-configs",
	"version": "2.1.1",
	"description": "Package for eslint and prettier configs",
	"main": "index.cjs",
	"scripts": {
		"lint": "yarn prettier --check . && yarn eslint --quiet .",
		"lint:fix": "yarn prettier --write . && yarn eslint --fix --quiet ."
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@unocss/eslint-config": "^66.6.7",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"vue-eslint-parser": "^10.4.0"
	}
}
